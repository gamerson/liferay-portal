Bundle-Name: Liferay Util Taglib
Bundle-SymbolicName: com.liferay.util.taglib
Bundle-Version: 4.0.0
Export-Package:\
	com.liferay.alloy.taglib.*;version="2.1.0",\
	com.liferay.taglib.*;-split-package:=merge-first
Import-Package:\
	!com.liferay.portal.freemarker,\
	\
	!jodd.*,\
	\
	!org.dom4j.*,\
	\
	!org.json.*,\
	\
	com.ibm.crypto.provider;resolution:=optional,\
	\
	com.liferay.*,\
	\
	*
Include-Resource:\
	classes,\
	@../util-java/util-java.jar!/com/liferay/util/Encryptor.class,\
	@../util-java/util-java.jar!/com/liferay/util/EncryptorException.class,\
	@../util-java/util-java.jar!/com/liferay/util/JS.class,\
	@../util-java/util-java.jar!/com/liferay/util/PwdGenerator.class,\
	@../util-java/util-java.jar!/com/liferay/util/RSSUtil.class
Provide-Capability:\
	osgi.extender;\
		osgi.extender="jsp.taglib";\
		uri="http://alloy.liferay.com/tld/alloy";\
		version:Version="${Bundle-Version}",\
	osgi.extender;\
		osgi.extender="jsp.taglib";\
		uri="http://alloy.liferay.com/tld/alloy_util";\
		version:Version="${Bundle-Version}",\
	osgi.extender;\
		osgi.extender="jsp.taglib";\
		uri="http://alloy.liferay.com/tld/aui";\
		version:Version="${Bundle-Version}",\
	osgi.extender;\
		osgi.extender="jsp.taglib";\
		uri="http://java.sun.com/portlet";\
		version:Version="${Bundle-Version}",\
	osgi.extender;\
		osgi.extender="jsp.taglib";\
		uri="http://java.sun.com/portlet_2_0";\
		version:Version="${Bundle-Version}",\
	osgi.extender;\
		osgi.extender="jsp.taglib";\
		uri="http://xmlns.jcp.org/portlet_3_0";\
		version:Version="${Bundle-Version}",\
	osgi.extender;\
		osgi.extender="jsp.taglib";\
		uri="http://liferay.com/tld/aui";\
		version:Version="${Bundle-Version}",\
	osgi.extender;\
		osgi.extender="jsp.taglib";\
		uri="http://liferay.com/tld/portlet";\
		version:Version="${Bundle-Version}",\
	osgi.extender;\
		osgi.extender="jsp.taglib";\
		uri="http://liferay.com/tld/security";\
		version:Version="${Bundle-Version}",\
	osgi.extender;\
		osgi.extender="jsp.taglib";\
		uri="http://liferay.com/tld/theme";\
		version:Version="${Bundle-Version}",\
	osgi.extender;\
		osgi.extender="jsp.taglib";\
		uri="http://liferay.com/tld/ui";\
		version:Version="${Bundle-Version}",\
	osgi.extender;\
		osgi.extender="jsp.taglib";\
		uri="http://liferay.com/tld/util";\
		version:Version="${Bundle-Version}"