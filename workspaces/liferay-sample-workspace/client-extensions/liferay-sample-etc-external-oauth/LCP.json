{
	"cpu": 1,
	"env": {
		"LIFERAY_ROUTES_CLIENT_EXTENSION": "/etc/liferay/lxc/ext-init-metadata",
		"LIFERAY_ROUTES_DXP": "/etc/liferay/lxc/dxp-metadata",

		"EXTERNAL_LIFERAY_OAUTH_USER_AGENT_OAUTH2_AUTHORIZATION_URI": "https://external.liferay.com/o/oauth2/authorize",
		"EXTERNAL_LIFERAY_OAUTH_USER_AGENT_OAUTH2_INTROSPECTION_URI": "https://external.liferay.com/o/oauth2/introspect",
		"EXTERNAL_LIFERAY_OAUTH_USER_AGENT_OAUTH2_JWKS_URI": "https://external.liferay.com/o/oauth2/jwks",
		"EXTERNAL_LIFERAY_OAUTH_USER_AGENT_OAUTH2_REDIRECT_URI": "https://external.liferay.com/o/oauth2/redirect",
		"EXTERNAL_LIFERAY_OAUTH_USER_AGENT_OAUTH2_TOKEN_URI": "https://external.liferay.com/o/oauth2/token",
		"EXTERNAL_LIFERAY_OAUTH_USER_AGENT_OAUTH2_USER_AGENT_AUDIENCE": "http://localhost:58081",
		"EXTERNAL_LIFERAY_OAUTH_USER_AGENT_OAUTH2_USER_AGENT_CLIENT_ID": "<user-agent-client-id>",
		"EXTERNAL_LIFERAY_OAUTH_USER_AGENT_OAUTH2_USER_AGENT_HOME_PAGE_URI": "http://localhost:58081",
		"EXTERNAL_LIFERAY_OAUTH_USER_AGENT_OAUTH2_USER_AGENT_SCOPES": "Liferay.Headless.Delivery.everything.read",

		"EXTERNAL_LIFERAY_OAUTH_HEADLESS_SERVER_OAUTH2_HEADLESS_SERVER_CLIENT_ID": "<headless-server-client-id>",
		"EXTERNAL_LIFERAY_OAUTH_HEADLESS_SERVER_OAUTH2_HEADLESS_SERVER_CLIENT_SECRET": "<headless-server-client-secret>",
		"EXTERNAL_LIFERAY_OAUTH_HEADLESS_SERVER_OAUTH2_HEADLESS_SERVER_HOME_PAGE_URI": "https://external.liferay.com",
		"EXTERNAL_LIFERAY_OAUTH_HEADLESS_SERVER_OAUTH2_TOKEN_URI": "https://external.liferay.com/o/oauth2/token"
	},
	"environments": {
		"infra": {
			"deploy": false
		}
	},
	"id": "__PROJECT_ID__",
	"kind": "Deployment",
	"livenessProbe": {
		"httpGet": {
			"path": "/ready",
			"port": 58081
		}
	},
	"loadBalancer": {
		"targetPort": 58081
	},
	"memory": 512,
	"readinessProbe": {
		"httpGet": {
			"path": "/ready",
			"port": 58081
		}
	},
	"scale": 1
}