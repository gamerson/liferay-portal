Bundle-SymbolicName: liferayhelloworld
Bundle-Version: 1.0.0
Web-ContextPath: /liferayhelloworld
Require-Capability:\
	osgi.extender;\
		filter:="(&(osgi.extender=osgi.configurator)(version>=1.0)(!(version>=2.0)))"
-includeresource:\
	{LCP.json},\
	{OSGI-INF/configurator/=configurator/osgi.config.json},\
	Dockerfile,\
	META-INF/resources/build/static/css=build/static/css;filter:=*.css;recursive:=false,\
	META-INF/resources/build/static/js=build/static/js;filter:=*.js;recursive:=false