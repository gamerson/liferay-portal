project.name=dynamicjscss
Bundle-SymbolicName: ${project.name}
Bundle-Version: 1.0.0
Web-ContextPath: /${project.name}
Require-Capability:\
	osgi.extender;\
		filter:="(&(osgi.extender=osgi.configurator)(version>=1.0)(!(version>=2.0)))"
-includeresource:\
	LCP.json;literal='\
{\n\
  "kind": "Deployment",\n\
  "id": "${project.name}",\n\
  "cpu": 0.1,\n\
  "scale": 1,\n\
  "memory": 50,\n\
  "loadBalancer": {\n\
    "targetPort": 80,\n\
    "cdn": true\n\
  },\n\
  "environments": {\n\
    "infra": {\n\
      "deploy": false\n\
    },\n\
    "dev": {\n\
      "loadBalancer": {\n\
        "targetPort": 80,\n\
        "cdn": false\n\
      }\n\
    }\n\
  }\n\
}',\
	OSGI-INF/configurator/osgi.config.json;literal='\
{\n\
    "com.liferay.dynamic.include.factory.configuration.v1.DynamicIncludeConfiguration~${project.name}": {\n\
        ":configurator:policy": "force",\n\
        "charset": "UTF-8",\n\
        "key": "/html/common/themes/top_js.jspf#resources",\n\
        "urls": [\n\
          "$[conf:host.service.address]/modal.js",\n\
          "$[conf:host.service.address]/modal.css"\n\
        ],\n\
        "host.service.address": "/o/${project.name}",\n\
        "timestamp": "${tstamp}"\n\
    }\n\
}',\
	Dockerfile;literal='\
FROM rotty3000/lxc-static-resources:latest\n\
COPY META-INF/resources /resources/',\
	META-INF/resources/=src;filter:=*.js;recursive:=false,\
	META-INF/resources/=src;filter:=*.css;recursive:=false